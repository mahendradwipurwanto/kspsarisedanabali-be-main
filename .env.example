# ── Database (SumoPod managed PostgreSQL) ────────────────────────────────────
# :6432 is session-pooled — prepared statements are safe. No direct 5432 exists.
DATABASE_URL=postgres://USER:PASSWORD@HOST:6432/DATABASE
# ⚠ SumoPod's listener currently refuses TLS. Set to "require" the moment they
#   enable it — see PROJECT-PLAN.md Blocker 1.
DATABASE_SSL=prefer
DATABASE_PREPARE=true

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48  
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30

# ── Object storage (Cloudeka Deka Box, S3-compatible) ────────────────────────
STORAGE_ENDPOINT=https://kencana.basic.box.cloudeka.id
STORAGE_REGION=kencana
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Leave empty while the bucket has no public-read policy — the LP will proxy
# images instead. Set to the CDN origin once Blocker 4 is resolved.
STORAGE_PUBLIC_URL=

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
LP_REVALIDATE_URL=http://localhost:3000/api/revalidate
# Must be the same value as REVALIDATE_SECRET in the landing page.
REVALIDATE_SECRET=
CRON_SECRET=
TURNSTILE_SECRET=
IP_HASH_SALT=

# ── Seed ─────────────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@sarisedanabali.co.id
SEED_ADMIN_PASSWORD=
