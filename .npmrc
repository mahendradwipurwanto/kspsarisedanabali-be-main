# @mahendradwipurwanto/ksp-contracts is published to GitHub Packages.
# Authentication comes from the environment — never commit a token here.
#   local:  export NODE_AUTH_TOKEN=<GitHub PAT with read:packages>
#   Vercel: add NODE_AUTH_TOKEN to the project's environment variables
@mahendradwipurwanto:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
